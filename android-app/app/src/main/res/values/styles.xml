<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#1f6feb</item>
        <item name="android:colorPrimaryDark">#161b22</item>
        <item name="android:colorAccent">#58a6ff</item>
        <item name="android:windowBackground">#0d1117</item>
        <item name="android:textColorPrimary">#c9d1d9</item>
        <item name="android:textColorSecondary">#8b949e</item>
        <item name="android:statusBarColor">#161b22</item>
        <item name="android:navigationBarColor">#161b22</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Card">
        <item name="android:background">#161b22</item>
        <item name="android:padding">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="Btn">
        <item name="android:background">#21262d</item>
        <item name="android:textColor">#c9d1d9</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="BtnPrimary" parent="Btn">
        <item name="android:background">#1f6feb</item>
        <item name="android:textColor">#ffffff</item>
    </style>

    <style name="Label">
        <item name="android:textColor">#8b949e</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Value">
        <item name="android:textColor">#c9d1d9</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
